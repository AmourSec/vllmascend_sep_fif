#include <acl/acl.h>
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_functions.h"

namespace {
constexpr uint32_t THREADS = 256;
constexpr uint32_t TILE_WORDS = 256;

__simt_vf__ __aicore__ LAUNCH_BOUND(THREADS) inline void CopySimt(__gm__ uint32_t* source, __gm__ uint32_t* destination,
                                                                  uint64_t words, int cacheGlobal) {
  for (uint64_t index = threadIdx.x; index < words; index += THREADS) {
    if (cacheGlobal != 0) {
      const uint32_t value = asc_ldcg(source + index);
      asc_stcg(destination + index, value);
    } else {
      destination[index] = source[index];
    }
  }
}
}  // namespace

extern "C" __global__ __aicore__ void host_probe_simt(GM_ADDR source, GM_ADDR destination, uint64_t words,
                                                      int cacheGlobal) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  AscendC::InitSocState();
  asc_vf_call<CopySimt>(dim3(THREADS), reinterpret_cast<__gm__ uint32_t*>(source),
                        reinterpret_cast<__gm__ uint32_t*>(destination), words, cacheGlobal);
}

extern "C" __global__ __aicore__ void host_probe_mte(GM_ADDR source, GM_ADDR destination, uint64_t words) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  AscendC::InitSocState();
  AscendC::TPipe pipe;
  AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
  pipe.InitBuffer(buffer, TILE_WORDS * sizeof(uint32_t));
  auto local = buffer.Get<uint32_t>();
  AscendC::GlobalTensor<uint32_t> input;
  AscendC::GlobalTensor<uint32_t> output;
  input.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(source), words);
  output.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(destination), words);
  for (uint64_t start = 0; start < words; start += TILE_WORDS) {
    const uint32_t count = words - start < TILE_WORDS ? static_cast<uint32_t>(words - start) : TILE_WORDS;
    AscendC::DataCopy(local, input[start], count);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(0);
    AscendC::DataCopy(output[start], local, count);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(0);
  }
}

extern "C" int a5_kernel_copy(void* source, void* destination, uint64_t words, int path, aclrtStream stream) {
  if (path == 3) {
    host_probe_mte<<<1, nullptr, stream>>>(static_cast<uint8_t*>(source), static_cast<uint8_t*>(destination), words);
  } else {
    host_probe_simt<<<1, nullptr, stream>>>(static_cast<uint8_t*>(source), static_cast<uint8_t*>(destination), words,
                                            path == 2);
  }
  return aclrtSynchronizeStream(stream);
}
